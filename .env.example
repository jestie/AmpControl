# Server
PORT=8095
HOST=0.0.0.0
NODE_ENV=development

# Sessions - must be a random string of 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=12
COOKIE_SECURE=false

# Devices config (never put hosts or secrets in the browser-facing files)
DEVICES_CONFIG=./config/devices.json

# Volume cap fallback for devices without their own volumeCap
DEFAULT_VOLUME_CAP=40

# Failed logins before a 15 minute lockout
LOGIN_MAX_FAILURES=5

# Logging
LOG_FILE=./logs/activity.log

# Auth
# First user is created from the command line: npm run user:create
# Users are stored in data/users.json (not committed).
